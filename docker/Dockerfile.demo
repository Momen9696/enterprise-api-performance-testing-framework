FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    DEMO_API_USERNAME=demo \
    DEMO_API_PASSWORD=demo-local-only \
    DEMO_TOKEN_SECRET=demo-token-secret-local

WORKDIR /app
RUN useradd --create-home --uid 10001 perfkit \
    && pip install --no-cache-dir --upgrade pip
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src ./src
COPY profiles ./profiles
RUN mkdir -p /data/reports && chown -R perfkit:perfkit /app /data
USER perfkit
EXPOSE 8090
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/health')"
CMD ["python", "-m", "uvicorn", "perfkit.demo.app:app", "--host", "0.0.0.0", "--port", "8090"]
