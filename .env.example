# Local demo credential. Synthetic only. Do not point this at a real system.
DEMO_API_USERNAME=demo
DEMO_API_PASSWORD=demo-local-only
DEMO_TOKEN_SECRET=demo-token-secret-local
DEMO_MAX_LATENCY_MS=400

# Execution caps. Profiles above these values are rejected.
PERF_MAX_USERS=25
PERF_MAX_DURATION_SECONDS=180
PERF_LOCUST_GRACE_SECONDS=45

# Comma-separated hostnames. Literal targets must still be loopback.
# Names on this list must resolve to loopback or a private address.
PERF_ALLOWED_HOSTS=localhost,127.0.0.1,::1,demo-api,host.docker.internal

# Optional. When set, loopback base URLs in profiles are rewritten to this URL
# after the same allowlist check. Docker Compose sets it to the demo service.
# PERF_TARGET_URL=http://demo-api:8090

PERF_DB=data/perfkit.sqlite
PERF_REPORTS_DIR=reports
